@model GomexPraksaMVC.Models.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="dashboard-header mb-4">
    <h2 class="mb-1">Dashboard</h2>
    <p class="text-secondary mb-0">
        Pregled prodaje, marže i odstupanja
    </p>
</div>

<div class="filter-card mb-4">
    <form method="get" class="filter-bar">
        <div class="filter-group">
            <label>Datum od</label>
            <input type="date" name="datumOd" class="form-control" value="@(Model?.DatumOd.HasValue == true ? Model.DatumOd.Value.ToString("yyyy-MM-dd") : string.Empty)" />
        </div>

        <div class="filter-group">
            <label>Datum do</label>
            <input type="date" name="datumDo" class="form-control" value="@(Model?.DatumDo.HasValue == true ? Model.DatumDo.Value.ToString("yyyy-MM-dd") : string.Empty)" />
        </div>

        <div class="filter-group">
            <label>Odeljenje</label>
            <div class="d-flex align-items-center">
                <select class="form-select" name="odeljenjeId">
                <option value="">Sva odeljenja</option>
                @foreach (var od in Model.Odeljenja)
                {
                    <option value="@od.OdeljenjeId" selected="@(Model?.OdeljenjeId == od.OdeljenjeId ? "selected" : null)">@od.Naziv</option>
                }
                </select>

            </div>
        </div>

        <div class="filter-group">
            <label>Kategorija</label>
            <select class="form-select" name="kategorijaId">
                <option value="">Sve kategorije</option>
                @foreach (var k in Model.Kategorije)
                {
                    <option value="@k.KategorijaId" selected="@(Model?.KategorijaId == k.KategorijaId ? "selected" : null)">@k.Naziv</option>
                }
            </select>
        </div>

        <div class="filter-group">
            <label>Dobavljač</label>
            <select class="form-select" name="dobavljacId">
                <option value="">Svi dobavljači</option>
                @foreach (var d in Model.Dobavljaci)
                {
                    <option value="@d.DobavljacId" selected="@(Model?.SelectedDobavljacId == d.DobavljacId ? "selected" : null)">@d.Naziv</option>
                }
            </select>
        </div>

        <div class="filter-group align-self-end d-flex">
            <button type="submit" class="btn btn-primary">Primeni filtere</button>
            <a href="@Url.Action("Index", "Dashboard")" class="btn btn-secondary ms-2">Ponisti filtere</a>
        </div>
    </form>
</div>


<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="metric-card">
            <div class="metric-label">Promet (bez PDV)</div>
            <div id="prometValue" class="metric-value">@((Model?.PrometBezPdv ?? 0m).ToString("N0")) RSD</div>
            <div id="prometYoY" class="metric-yoy @(Model != null && Model.PrometPromenaProcenat >= 0 ? "positive" : "negative")">@(((Model?.PrometPromenaProcenat ?? 0m) * 100m).ToString("0.0"))% vs prethodni period</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="metric-card">
            <div class="metric-label">Apsolutna zarada</div>
            <div id="zaradaValue" class="metric-value">@((Model?.Ruc12 ?? 0m).ToString("N0")) RSD</div>
            <div id="zaradaYoY" class="metric-yoy @(Model != null && Model.Ruc12PromenaProcenat >= 0 ? "positive" : "negative")">@(((Model?.Ruc12PromenaProcenat ?? 0m) * 100m).ToString("0.0"))% vs prethodni period</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="metric-card">
            <div class="metric-label">Marža (RUC12%)</div>
            <div id="marzaValue" class="metric-value text-danger">@(((Model?.Ruc12Procenat ?? 0m) * 100m).ToString("0.0"))%</div>            <div id="marzaYoY" class="metric-yoy @(Model != null && Model.Ruc12PromenaProcentniPoeni >= 0 ? "positive" : "negative")">Plan 22,0% · @((Model?.Ruc12PromenaProcentniPoeni ?? 0m).ToString("0.0")) p.p.</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="metric-card">
            <div class="metric-label">Artikli u padu</div>
            <div id="artikliValue" class="metric-value">@((Model?.KriticniArtikli ?? 0))</div>
            <div id="artikliYoY" class="metric-yoy @(Model != null && Model.KriticniArtikliPromena >= 0 ? "positive" : "negative")">@((Model?.KriticniArtikliPromena >= 0 ? "+" : "") + (Model?.KriticniArtikliPromena ?? 0).ToString()) vs prethodni period</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="metric-card">
            <div class="metric-label">Najveći rast (RSD)</div>
            <div id="najveciRastValue" class="metric-value">@((Model?.NedostatakMarze ?? 0m).ToString("N0"))</div>
            <div id="najveciRastYoY" class="metric-yoy @(Model != null && Model.NedostatakMarzePromenaProcenat >= 0 ? "positive" : "negative")">@(((Model?.NedostatakMarzePromenaProcenat ?? 0m) * 100m).ToString("0.0"))% vs prethodni period</div>
        </div>
    </div>

<div class="metric-card mb-4">
    <div class="metric-label mb-2">Promet — trenutni period naspram prethodnog</div>
    <canvas id="prometChart" height="90"></canvas>
</div>
    <div class="d-flex justify-content-end mb-2" id="prometChartLegend" style="font-size:12px;">
        <span style="color:#1F4E5C;">&#9679;</span>&nbsp;2026&nbsp;&nbsp;
        <span style="color:#B4B2A9;">&#9679;</span>&nbsp;Prethodni period
    </div>
    <canvas id="prometChart" height="70"></canvas>
</div>

@if (Model?.RucChange != null)
{
    <div class="metric-card mb-4">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <div class="metric-label mb-0">Zašto se RUC promenio?</div>
            <small class="text-secondary">RSD</small>
        </div>
        <canvas id="rucWaterfall" height="140"></canvas>
        <div class="mt-2 small text-secondary">
            <div>Pocetni RUC: @Model.RucChange.PocetniRuc.ToString("N0")</div>
            <div>Konacni RUC: @Model.RucChange.KonacniRuc.ToString("N0")</div>
        </div>
    </div>
}

@if (Model?.CriticalTop5 != null && Model.CriticalTop5.Any())
{
    <div class="metric-card mb-4">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <div class="metric-label mb-0">Top 5 kritičnih proizvoda</div>
            <small class="text-secondary">Procenjeni uticaj (RSD)</small>
        </div>
        <canvas id="criticalTopChart" height="140"></canvas>
        <div class="mt-3">
            <table class="table table-sm">
                <thead>
                    <tr class="text-secondary small">
                        <th>Artikal</th>
                        <th>Kategorija</th>
                        <th>Severnost</th>
                        <th class="text-end">Uticaj</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.CriticalTop5.Count; i++)
                    {
                        var item = Model.CriticalTop5[i];
                        <tr>
                            <td>@item.NazivArtikla</td>
                            <td>@item.Kategorija</td>
                            <td>@item.Severnost</td>
                            <td class="text-end">@item.ProcenjeniUticaj.ToString("N0")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div class="mb-4">
        <em class="text-secondary">Nema kritičnih proizvoda za izabrani period.</em>
    </div>
}

<div class="mt-5 mb-3">
    <h5 class="mb-1">Pregled po odeljenjima</h5>
    <small class="text-secondary">
        Kliknite na odeljenje za prikaz artikala.
    </small>
</div>



@section Scripts {
    <script>
        window.__dashboardData = {
            criticalTop: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model?.CriticalTop5 ?? Enumerable.Empty<object>())),
            rucChange: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model?.RucChange)),
            promet: {
                trenutni: @((Model?.PrometBezPdv ?? 0m).ToString(System.Globalization.CultureInfo.InvariantCulture)),
                promenaProcenat: @((Model?.PrometPromenaProcenat ?? 0m).ToString(System.Globalization.CultureInfo.InvariantCulture))
                    }
        };
    </script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    <script src="~/js/Dashboard.js" asp-append-version="true"></script>
    <script src="~/js/artikal.js" asp-append-version="true"></script>
}

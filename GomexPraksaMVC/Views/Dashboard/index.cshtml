@model GomexPraksaMVC.Models.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="dashboard-header mb-4">
    <h2 class="mb-1">Dashboard</h2>
    <p class="text-secondary mb-0">
        Pregled prodaje, RUC-a i odstupanja
    </p>
</div>

<div class="filter-card mb-4">
    <form method="get" class="filter-bar">

        <div class="filter-group">
            <label>Datum od</label>
            <input type="date"
                   name="datumOd"
                   class="form-control"
                   value="@(Model.DatumOd?.ToString("yyyy-MM-dd") ?? string.Empty)" />
        </div>

        <div class="filter-group">
            <label>Datum do</label>
            <input type="date"
                   name="datumDo"
                   class="form-control"
                   value="@(Model.DatumDo?.ToString("yyyy-MM-dd") ?? string.Empty)" />
        </div>

        <div class="filter-group">
            <label>Odeljenje</label>

            <select class="form-select"
                    name="odeljenjeId">

                <option value="">
                    Sva odeljenja
                </option>

                @foreach (var od in Model.Odeljenja)
                {
                    <option value="@od.OdeljenjeId"
                            selected="@(Model.OdeljenjeId == od.OdeljenjeId)">
                        @od.Naziv
                    </option>
                }

            </select>
        </div>

        <div class="filter-group">
            <label>Kategorija</label>

            <select class="form-select"
                    name="kategorijaId">

                <option value="">
                    Sve kategorije
                </option>

                @foreach (var kategorija in Model.Kategorije)
                {
                    <option value="@kategorija.KategorijaId"
                            selected="@(Model.KategorijaId == kategorija.KategorijaId)">
                        @kategorija.Naziv
                    </option>
                }

            </select>
        </div>

        <div class="filter-group">
            <label>Dobavljač</label>

            <select class="form-select"
                    name="dobavljacId">

                <option value="">
                    Svi dobavljači
                </option>

                @foreach (var dobavljac in Model.Dobavljaci)
                {
                    <option value="@dobavljac.DobavljacId"
                            selected="@(Model.SelectedDobavljacId == dobavljac.DobavljacId)">
                        @dobavljac.Naziv
                    </option>
                }

            </select>
        </div>

        @if (Model.TipoviProdaje.Any())
        {
            <div class="filter-group">
                <label>Tip prodaje</label>

                <select class="form-select"
                        name="tipProdajeId">

                    <option value="">
                        Svi tipovi prodaje
                    </option>

                    @foreach (var tip in Model.TipoviProdaje)
                    {
                        <option value="@tip.TipProdajeId"
                                selected="@(Model.TipProdajeId == tip.TipProdajeId)">
                            @tip.Naziv
                        </option>
                    }

                </select>
            </div>
        }

        <div class="filter-group align-self-end d-flex">
            <button type="submit"
                    class="btn btn-primary">

                Primeni filtere
            </button>

            <a href="@Url.Action("Index", "Dashboard")"
               class="btn btn-secondary ms-2">

                Poništi filtere
            </a>
        </div>

    </form>
</div>

<div class="row g-3 mb-4">

    <div class="col-md-4">
        <div class="metric-card">

            <div class="metric-label">
                Promet (bez PDV)
            </div>

            <div id="prometValue"
                 class="metric-value">

                @Model.PrometBezPdv.ToString("N0") RSD
            </div>

            <div id="prometYoY"
                 class="metric-yoy @(Model.PrometPromenaProcenat >= 0 ? "positive" : "negative")">

                @((Model.PrometPromenaProcenat * 100m).ToString("0.0"))%
                vs prethodni period
            </div>

        </div>
    </div>

    <div class="col-md-4">
        <div class="metric-card">

            <div class="metric-label">
                RUC12 (RSD)
            </div>

            <div id="zaradaValue"
                 class="metric-value">

                @Model.Ruc12.ToString("N0") RSD
            </div>

            <div id="zaradaYoY"
                 class="metric-yoy @(Model.Ruc12PromenaProcenat >= 0 ? "positive" : "negative")">

                @((Model.Ruc12PromenaProcenat * 100m).ToString("0.0"))%
                vs prethodni period
            </div>

        </div>
    </div>

    <div class="col-md-4">
        <div class="metric-card">

            <div class="metric-label">
                Marža (RUC12%)
            </div>

            <div id="marzaValue"
                 class="metric-value @(Model.Ruc12Procenat >= 0 ? "text-success" : "text-danger")">

                @((Model.Ruc12Procenat * 100m).ToString("0.0"))%
            </div>

            <div id="marzaYoY"
                 class="metric-yoy @(Model.Ruc12PromenaProcentniPoeni >= 0 ? "positive" : "negative")">

                @((Model.Ruc12PromenaProcentniPoeni * 100m).ToString("+0.0;-0.0;0.0"))
                p.p. vs prethodni period
            </div>

        </div>
    </div>

    <div class="col-md-4">
        <div class="metric-card">

            <div class="metric-label">
                Kritični artikli
            </div>

            <div id="artikliValue"
                 class="metric-value">

                @Model.KriticniArtikli
            </div>

            <div id="artikliYoY"
                 class="metric-yoy @(Model.KriticniArtikliPromena <= 0 ? "positive" : "negative")">

                @(Model.KriticniArtikliPromena >= 0 ? "+" : "")
                @Model.KriticniArtikliPromena
                vs prethodni period
            </div>

        </div>
    </div>

    <div class="col-md-4">
        <div class="metric-card">

            <div class="metric-label">
                Nedostatak margine
            </div>

            <div id="nedostatakMarzeValue"
                 class="metric-value @(Model.NedostatakMarze >= 0 ? "text-success" : "text-danger")">

                @Model.NedostatakMarze.ToString("N0") RSD
            </div>

            <div id="nedostatakMarzeYoY"
                 class="metric-yoy">

                @((Model.NedostatakMarzePromenaProcenat * 100m).ToString("+0.0;-0.0;0.0"))%
                vs prethodni period
            </div>

        </div>
    </div>

</div>

<div class="metric-card mb-4">

    <div class="d-flex justify-content-between align-items-center mb-2">
        <div class="metric-label mb-0">
            Promet — trenutni period naspram prethodnog
        </div>

        <small class="text-secondary">
            RSD
        </small>
    </div>

    <canvas id="prometChart"
            height="90">
    </canvas>

</div>

@if (Model.RucChange != null)
{
    <div class="metric-card mb-4">

        <div class="d-flex justify-content-between align-items-center mb-2">

            <div class="metric-label mb-0">
                Zašto se RUC promenio?
            </div>

            <small class="text-secondary">
                RSD
            </small>

        </div>

        <canvas id="rucWaterfall"
                height="140">
        </canvas>

        <div class="mt-3 small text-secondary">

            <div>
                Početni RUC:
                @Model.RucChange.PocetniRuc.ToString("N0") RSD
            </div>

            <div>
                Konačni RUC:
                @Model.RucChange.KonacniRuc.ToString("N0") RSD
            </div>

            <div>
                Ukupna promena:
                @Model.RucChange.UkupnaPromena.ToString("N0") RSD
            </div>

        </div>

    </div>
}

@if (Model.CriticalTop5.Any())
{
    <div class="metric-card mb-4">

        <div class="d-flex justify-content-between align-items-center mb-2">

            <div class="metric-label mb-0">
                Top 5 kritičnih proizvoda
            </div>

            <small class="text-secondary">
                Procenjeni uticaj (RSD)
            </small>

        </div>

        <canvas id="criticalTopChart"
                height="140">
        </canvas>

        <div class="mt-3">

            <table class="table table-sm">

                <thead>
                    <tr class="text-secondary small">
                        <th>Artikal</th>
                        <th>Kategorija</th>
                        <th>Severnost</th>
                        <th class="text-end">
                            Uticaj
                        </th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in Model.CriticalTop5)
                    {
                        <tr>

                            <td>
                                @item.NazivArtikla
                            </td>

                            <td>
                                @item.Kategorija
                            </td>

                            <td>
                                @item.Severnost
                            </td>

                            <td class="text-end">
                                @item.ProcenjeniUticaj.ToString("N0") RSD
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>
}
else
{
    <div class="metric-card mb-4">

        <em class="text-secondary">
            Nema kritičnih proizvoda za izabrani period.
        </em>

    </div>
}

@if (Model.PodaciOsvezeni.HasValue)
{
    <div class="text-end text-secondary small mb-4">

        Podaci osveženi:
        @Model.PodaciOsvezeni.Value.ToString("dd.MM.yyyy HH:mm")

    </div>
}

@section Scripts
{
    <script>
        window.__dashboardData = {
            criticalTop: @Html.Raw(
                            System.Text.Json.JsonSerializer.Serialize(
                            Model.CriticalTop5
                            )
                            ),

            rucChange: @Html.Raw(
                            System.Text.Json.JsonSerializer.Serialize(
                            Model.RucChange
                            )
                            ),

            promet: {
                trenutni:
                    @Model.PrometBezPdv.ToString(
                    System.Globalization.CultureInfo.InvariantCulture
                    ),

                promenaProcenat:
                    @Model.PrometPromenaProcenat.ToString(
                    System.Globalization.CultureInfo.InvariantCulture
                    )
                    }
        };
    </script>

    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js">
    </script>

    <script src="~/js/Dashboard.js"
            asp-append-version="true">
    </script>
}
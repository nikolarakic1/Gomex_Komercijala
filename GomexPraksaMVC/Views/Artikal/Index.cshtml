@model GomexPraksaMVC.Models.ArtikalIndexViewModel

@{
    ViewData["Title"] = "Artikli";
}

<div class="d-flex justify-content-between align-items-start mb-4">

    <div>
        <h4 class="mb-1">
            Artikli
        </h4>

        <div class="text-secondary small">
            Pregled proizvoda i komercijalnih rezultata
        </div>
    </div>

    <div class="text-secondary small">
        Ukupno: @Model.TotalCount
    </div>

</div>

<div class="metric-card mb-4">

    <form asp-controller="Artikal"
          asp-action="Index"
          method="get">

        <input type="hidden"
               name="page"
               value="1" />

        <input type="hidden"
               name="pageSize"
               value="@Model.PageSize" />

        <div class="row g-3">

            <div class="col-xl-3 col-md-6">

                <label class="form-label small">
                    Naziv
                </label>

                <input type="text"
                       name="naziv"
                       value="@Model.Naziv"
                       class="form-control"
                       placeholder="Naziv artikla" />

            </div>

            <div class="col-xl-2 col-md-6">

                <label class="form-label small">
                    Šifra
                </label>

                <input type="text"
                       name="sifra"
                       value="@Model.Sifra"
                       class="form-control"
                       placeholder="Šifra artikla" />

            </div>

            <div class="col-xl-3 col-md-6">

                <label class="form-label small">
                    Dobavljač
                </label>

                <select name="dobavljacId"
                        class="form-select">

                    <option value="">
                        Svi dobavljači
                    </option>

                    @foreach (var d in Model.Dobavljaci)
                    {
                        if (Model.SelectedDobavljacId ==
                            d.DobavljacId)
                        {
                            <option value="@d.DobavljacId"
                                    selected>
                                @d.Naziv
                            </option>
                        }
                        else
                        {
                            <option value="@d.DobavljacId">
                                @d.Naziv
                            </option>
                        }
                    }

                </select>

            </div>

            <div class="col-xl-2 col-md-6">

                <label class="form-label small">
                    Odeljenje
                </label>

                <select name="odeljenjeId"
                        class="form-select">

                    <option value="">
                        Sva odeljenja
                    </option>

                    @foreach (var o in Model.Odeljenja)
                    {
                        if (Model.SelectedOdeljenjeId ==
                            o.OdeljenjeId)
                        {
                            <option value="@o.OdeljenjeId"
                                    selected>
                                @o.Naziv
                            </option>
                        }
                        else
                        {
                            <option value="@o.OdeljenjeId">
                                @o.Naziv
                            </option>
                        }
                    }

                </select>

            </div>

            <div class="col-xl-2 col-md-6 d-flex align-items-end">

                <div class="d-flex gap-2 w-100">

                    <button type="submit"
                            class="btn btn-primary flex-grow-1">

                        Primeni

                    </button>

                    <a asp-controller="Artikal"
                       asp-action="Index"
                       class="btn btn-outline-secondary">

                        Reset

                    </a>

                </div>

            </div>

        </div>

    </form>

</div>

<div class="metric-card p-0 overflow-hidden">

    <div class="table-responsive">

        <table class="table table-hover align-middle mb-0">

            <thead>

                <tr>

                    <th class="ps-3">
                        Šifra
                    </th>

                    <th>
                        Naziv
                    </th>

                    <th>
                        Dobavljač
                    </th>

                    <th class="text-end">
                        Promet
                    </th>

                    <th class="text-end">
                        RUC12
                    </th>

                    <th class="text-end">
                        RUC12 %
                    </th>

                    <th class="text-end">
                        MIX+MARGINA
                    </th>

                    <th class="text-end pe-3">
                        Detalji
                    </th>

                </tr>

            </thead>

            <tbody>

                @if (Model.Artikli.Any())
                {
                    foreach (var artikal in Model.Artikli)
                    {
                        var rucKlasa =
                            artikal.RUC12 < 0
                                ? "text-danger"
                                : artikal.RUC12 > 0
                                    ? "text-success"
                                    : "text-secondary";

                        var marginaKlasa =
                            artikal.Margina < 0
                                ? "text-danger"
                                : artikal.Margina > 0
                                    ? "text-success"
                                    : "text-secondary";

                        <tr>

                            <td class="ps-3">

                                <span class="fw-medium">
                                    @artikal.Sifra
                                </span>

                            </td>

                            <td>

                                <div class="fw-medium">
                                    @artikal.Naziv
                                </div>

                                @if (artikal.RedovnaCena.HasValue)
                                {
                                    <div class="text-secondary small">

                                        Cena:
                                        @artikal.RedovnaCena.Value.ToString("N2")
                                        RSD

                                    </div>
                                }

                            </td>

                            <td>

                                @if (!string.IsNullOrWhiteSpace(
                                    artikal.NazivDobavljaca))
                                {
                                    @artikal.NazivDobavljaca
                                }
                                else
                                {
                                    <span class="text-secondary">
                                        —
                                    </span>
                                }

                            </td>

                            <td class="text-end">

                                <span class="fw-medium">
                                    @artikal.Promet.ToString("N0")
                                </span>

                                <span class="text-secondary small">
                                    RSD
                                </span>

                            </td>

                            <td class="text-end @rucKlasa">

                                <span class="fw-medium">
                                    @artikal.RUC12.ToString("N0")
                                </span>

                                <span class="small">
                                    RSD
                                </span>

                            </td>

                            <td class="text-end">

                                @(
                                    (artikal.RUC12Procenat * 100m)
                                    .ToString("N2")
                                )%

                            </td>

                            <td class="text-end @marginaKlasa">

                                <span class="fw-medium">
                                    @artikal.Margina.ToString("N0")
                                </span>

                                <span class="small">
                                    RSD
                                </span>

                            </td>

                            <td class="text-end pe-3">

                                <a asp-controller="Artikal"
                                   asp-action="Detalji"
                                   asp-route-sifra="@artikal.Sifra"
                                   class="btn btn-sm btn-outline-primary">

                                    Detalji

                                </a>

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>

                        <td colspan="8"
                            class="text-center text-secondary py-5">

                            Nema pronađenih artikala.

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

    @if (Model.TotalPages > 0)
    {
        <div class="d-flex justify-content-between align-items-center p-3 border-top">

            <div class="text-secondary small">

                Strana

                <strong>
                    @Model.Page
                </strong>

                od

                <strong>
                    @Model.TotalPages
                </strong>

                &middot;

                Ukupno @Model.TotalCount artikala

            </div>

            <div class="d-flex gap-2">

                @if (Model.HasPreviousPage)
                {
                    <a asp-controller="Artikal"
                       asp-action="Index"
                       asp-route-page="@(Model.Page - 1)"
                       asp-route-pageSize="@Model.PageSize"
                       asp-route-naziv="@Model.Naziv"
                       asp-route-sifra="@Model.Sifra"
                       asp-route-dobavljacId="@Model.SelectedDobavljacId"
                       asp-route-robnaGrupaId="@Model.SelectedRobnaGrupaId"
                       asp-route-odeljenjeId="@Model.SelectedOdeljenjeId"
                       asp-route-kategorijaId="@Model.SelectedKategorijaId"
                       class="btn btn-sm btn-outline-secondary">

                        Prethodna

                    </a>
                }

                @if (Model.HasNextPage)
                {
                    <a asp-controller="Artikal"
                       asp-action="Index"
                       asp-route-page="@(Model.Page + 1)"
                       asp-route-pageSize="@Model.PageSize"
                       asp-route-naziv="@Model.Naziv"
                       asp-route-sifra="@Model.Sifra"
                       asp-route-dobavljacId="@Model.SelectedDobavljacId"
                       asp-route-robnaGrupaId="@Model.SelectedRobnaGrupaId"
                       asp-route-odeljenjeId="@Model.SelectedOdeljenjeId"
                       asp-route-kategorijaId="@Model.SelectedKategorijaId"
                       class="btn btn-sm btn-outline-primary">

                        Sledeća

                    </a>
                }

            </div>

        </div>
    }

</div>
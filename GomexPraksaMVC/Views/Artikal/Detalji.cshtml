@model GomexPraksaMVC.Models.ArtikalViewItem

@{
    ViewData["Title"] = "Detalji artikla";

    var aktivnaAkcija =
        ViewData["AktivnaAkcija"]
        as GomexPraksaMVC.Models.AkcijaViewItem;

    var rucBoja =
        Model.RUC12 < 0
            ? "#C1443B"
            : Model.RUC12 > 0
                ? "#2E7D5B"
                : "#6C757D";

    var marginaBoja =
        Model.Margina < 0
            ? "#C1443B"
            : Model.Margina > 0
                ? "#2E7D5B"
                : "#6C757D";

    var odstupanjeBoja =
        Model.OdstupanjeRUC12ProcentniPoeni < 0
            ? "#C1443B"
            : Model.OdstupanjeRUC12ProcentniPoeni > 0
                ? "#2E7D5B"
                : "#6C757D";
}

<a asp-controller="Artikal"
   asp-action="Index"
   class="text-decoration-none text-secondary small mb-3 d-inline-block">

    &larr; Nazad na artikle

</a>

<div class="d-flex justify-content-between align-items-start mb-4">

    <div>

        <h4 class="mb-1">
            @Model.Naziv
        </h4>

        <div class="text-secondary small">

            Šifra @Model.Sifra

            @if (!string.IsNullOrWhiteSpace(
                Model.NazivDobavljaca))
            {
                <text>
                    &middot;
                    Dobavljač: @Model.NazivDobavljaca
                </text>
            }

        </div>

    </div>

    <span class="badge"
          style="
        background:@(Model.Aktivan ? "#E7F3EC" : "#FBEAEA");
        color:@(Model.Aktivan ? "#2E7D5B" : "#C1443B");
        font-size:12px;
        padding:6px 12px;">

        @(Model.Aktivan
            ? "Aktivan"
            : "Neaktivan")

    </span>

</div>

<div class="row g-3 mb-4">

    <div class="col-xl-3 col-md-6">

        <div class="metric-card h-100">

            <div class="metric-label">
                Redovna cena
            </div>

            <div class="metric-value"
                 style="font-size:22px;">

                @(
                    Model.RedovnaCena.HasValue
                        ? Model.RedovnaCena.Value.ToString("N2") + " RSD"
                        : "—"
                )

            </div>

        </div>

    </div>

    @if (aktivnaAkcija != null)
    {
        <div class="col-xl-3 col-md-6">

            <div class="metric-card h-100"
                 style="
                border-left:3px solid #2E7D5B;
                border-radius:0 8px 8px 0;">

                <div class="metric-label">
                    Akcijska cena
                </div>

                <div class="metric-value"
                     style="
                    font-size:22px;
                    color:#2E7D5B;">

                    @aktivnaAkcija.AkcijskaCena.ToString("N2")
                    RSD

                </div>

                @if (aktivnaAkcija.ProcenatPopusta.HasValue)
                {
                    <div class="metric-yoy positive">

                        -@aktivnaAkcija.ProcenatPopusta.Value%
                        popusta

                    </div>
                }

            </div>

        </div>

        <div class="col-xl-6 col-md-12">

            <div class="metric-card h-100 d-flex align-items-center justify-content-between">

                <div>

                    <div class="metric-label">
                        Aktivna akcija
                    </div>

                    <div class="fw-medium mt-1">
                        @aktivnaAkcija.TipAkcije
                    </div>

                </div>

                <div class="text-end text-secondary small">

                    @aktivnaAkcija.DatumOd.ToString("dd.MM.yyyy.")

                    <br />

                    do

                    @aktivnaAkcija.DatumDo.ToString("dd.MM.yyyy.")

                </div>

            </div>

        </div>
    }
    else
    {
        <div class="col-xl-9 col-md-6">

            <div class="metric-card h-100 d-flex align-items-center">

                <span class="text-secondary small">

                    <i class="bi bi-dash-circle me-1"></i>

                    Artikal trenutno nije u akciji.

                </span>

            </div>

        </div>
    }

</div>

<div class="d-flex justify-content-between align-items-center mb-3">

    <h6 class="mb-0">
        Komercijalne performanse
    </h6>

    @if (Model.PoslednjiDatumPodataka.HasValue)
    {
        <span class="text-secondary small">

            Poslednji podaci:
            @Model.PoslednjiDatumPodataka.Value.ToString("dd.MM.yyyy.")

        </span>
    }

</div>

<div class="row g-3 mb-4">

    <div class="col-xl-3 col-md-6">

        <div class="metric-card h-100">

            <div class="metric-label">
                Promet
            </div>

            <div class="metric-value"
                 style="font-size:20px;">

                @Model.Promet.ToString("N0") RSD

            </div>

        </div>

    </div>

    <div class="col-xl-3 col-md-6">

        <div class="metric-card h-100">

            <div class="metric-label">
                RUC12
            </div>

            <div class="metric-value"
                 style="
                font-size:20px;
                color:@rucBoja;">

                @Model.RUC12.ToString("N0") RSD

            </div>

        </div>

    </div>

    <div class="col-xl-3 col-md-6">

        <div class="metric-card h-100">

            <div class="metric-label">
                RUC12 %
            </div>

            <div class="metric-value"
                 style="font-size:20px;">

                @(
                    (Model.RUC12Procenat * 100m)
                    .ToString("N2")
                )%

            </div>

        </div>

    </div>

    <div class="col-xl-3 col-md-6">

        <div class="metric-card h-100">

            <div class="metric-label">
                Margina
            </div>

            <div class="metric-value"
                 style="
                font-size:20px;
                color:@marginaBoja;">

                @Model.Margina.ToString("N0") RSD

            </div>

            <div class="text-secondary small mt-1">
                Mix + margina
            </div>

        </div>

    </div>

</div>

<h6 class="mb-3">
    Plan i odstupanje
</h6>

<div class="row g-3 mb-4">

    <div class="col-xl-3 col-md-6">

        <div class="metric-card h-100">

            <div class="metric-label">
                Planirani promet
            </div>

            <div class="metric-value"
                 style="font-size:20px;">

                @Model.PlanPromet.ToString("N0") RSD

            </div>

        </div>

    </div>

    <div class="col-xl-3 col-md-6">

        <div class="metric-card h-100">

            <div class="metric-label">
                Planirani RUC12
            </div>

            <div class="metric-value"
                 style="font-size:20px;">

                @Model.PlanRUC12.ToString("N0") RSD

            </div>

        </div>

    </div>

    <div class="col-xl-3 col-md-6">

        <div class="metric-card h-100">

            <div class="metric-label">
                Plan RUC12 %
            </div>

            <div class="metric-value"
                 style="font-size:20px;">

                @(
                    (Model.PlanRUC12Procenat * 100m)
                    .ToString("N2")
                )%

            </div>

        </div>

    </div>

    <div class="col-xl-3 col-md-6">

        <div class="metric-card h-100">

            <div class="metric-label">
                Odstupanje RUC12
            </div>

            <div class="metric-value"
                 style="
                font-size:20px;
                color:@odstupanjeBoja;">

                @(
                    (Model.OdstupanjeRUC12ProcentniPoeni * 100m)
                    .ToString("+0.00;-0.00;0.00")
                ) pp

            </div>

        </div>

    </div>

</div>

<div class="row g-3">

    <div class="col-md-6">

        <div class="metric-card h-100">

            <div class="metric-label">
                Nedostatak margine
            </div>

            <div class="metric-value"
                 style="
                font-size:20px;
                color:@(
                 Model.NedostatakMargine < 0
                     ? "#C1443B"
                     : Model.NedostatakMargine > 0
                         ? "#2E7D5B"
                         : "#6C757D"
                                );">

                @Model.NedostatakMargine.ToString("N0")
                RSD

            </div>

        </div>

    </div>

    <div class="col-md-6">

        <div class="metric-card h-100">

            <div class="metric-label">
                Poslednji dostupni podaci
            </div>

            <div class="metric-value"
                 style="font-size:20px;">

                @(
                    Model.PoslednjiDatumPodataka.HasValue
                        ? Model.PoslednjiDatumPodataka.Value
                            .ToString("dd.MM.yyyy.")
                        : "—"
                )

            </div>

        </div>

    </div>

</div>
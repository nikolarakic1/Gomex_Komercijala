@model GomexPraksaMVC.Models.ArtikalViewItem
@{
    ViewData["Title"] = "Detalji artikla";
    var dobavljacNaziv = ViewData["DobavljacNaziv"] as string;
}

<a asp-controller="Dashboard" asp-action="Index" class="text-decoration-none text-secondary small mb-3 d-inline-block">
    &larr; Nazad na dashboard
</a>

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h4 class="mb-1">@Model?.Naziv</h4>
        <div class="text-secondary small">
            Šifra @Model?.Sifra
            @if (!string.IsNullOrWhiteSpace(dobavljacNaziv))
            {
                <text> &middot; Dobavljač: @dobavljacNaziv</text>
            }
        </div>
    </div>
    <span class="badge" style="background:@(Model != null && Model.Aktivan ? "#E7F3EC" : "#FBEAEA"); color:@(Model != null && Model.Aktivan ? "#2E7D5B" : "#C1443B"); font-size:12px; padding:6px 12px;">
        @(Model != null && Model.Aktivan ? "Aktivan" : "Neaktivan")
    </span>
</div>

<div class="metric-card mb-4">
    <div class="text-secondary small">
    Dodace se
    </div>
</div>
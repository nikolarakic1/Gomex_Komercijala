@{
    ViewData["Title"] = "Detalji artikla";
    var sifra = ViewData["Sifra"];
}

<a asp-controller="Dashboard" asp-action="Index" class="text-decoration-none text-secondary small mb-3 d-inline-block">
    &larr; Nazad na dashboard
</a>

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h4 class="mb-1">Sveže voće nektarina 1</h4>
        <div class="text-secondary small">
            Šifra @sifra &middot; Dobavljač: Carska bašta doo &middot; Odeljenje: Voće
        </div>
    </div>
    <span class="badge" style="background:#FAEEDA; color:#854F0B; font-size:12px; padding:6px 12px;">
        U akciji &middot; Fresh akcija
    </span>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="metric-card">
            <div class="metric-label">Prodajna cena (sa PDV)</div>
            <div class="metric-value" style="font-size:20px;">159,21 RSD</div>
            <div class="metric-yoy positive">Plan 158,23 RSD</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="metric-card">
            <div class="metric-label">Nabavna cena</div>
            <div class="metric-value" style="font-size:20px;">119,10 RSD</div>
            <div class="metric-yoy negative">Plan 81,76 RSD</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="metric-card">
            <div class="metric-label">RUC1 / kom</div>
            <div class="metric-value" style="font-size:20px;">39,44 RSD</div>
            <div class="metric-yoy">Plan 40,32 RSD</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="metric-card">
            <div class="metric-label">RUC1+2 / kom</div>
            <div class="metric-value" style="font-size:20px;">39,44 RSD</div>
            <div class="metric-yoy">Plan 40,32 RSD</div>
        </div>
    </div>
</div>

<div class="metric-card mb-4" style="border-left:3px solid #C1443B; border-radius:0 8px 8px 0;">
    <div class="fw-medium mb-2" style="font-size:14px;">Uzrok pada marže</div>
    <div class="d-flex justify-content-between small text-secondary mb-1">
        <span>Efekat RUC1 (nabavna/osnovni rabat)</span>
        <span class="text-danger">-30,20 RSD/kom</span>
    </div>
    <div class="d-flex justify-content-between small text-secondary">
        <span>Efekat RUC2 (drugi rabat)</span>
        <span>0,00 RSD/kom</span>
    </div>
</div>

<div class="metric-card mb-4">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <div class="metric-label mb-0" id="chartTitle">Prodata količina po nedeljama</div>
        <div class="d-flex align-items-center gap-2">
            <div class="btn-group btn-group-sm">
                <button type="button" class="btn btn-outline-secondary" id="btnPrev">&laquo;</button>
                <button type="button" class="btn btn-outline-secondary" id="btnNext">&raquo;</button>
            </div>
            <div class="btn-group btn-group-sm" role="group" id="granularityToggle">
                <button type="button" class="btn btn-outline-secondary active" data-granularity="nedelja">Nedelja</button>
                <button type="button" class="btn btn-outline-secondary" data-granularity="mesec">Mesec</button>
                <button type="button" class="btn btn-outline-secondary" data-granularity="godina">Godina</button>
            </div>
            <select class="form-select form-select-sm" id="compareYearSelect" style="width:150px">
                <option value="2025">Uporedi sa 2025</option>
                <option value="2024">Uporedi sa 2024</option>
                <option value="2023">Uporedi sa 2023</option>
            </select>
        </div>
    </div>
    <div class="d-flex justify-content-end mb-2" id="chartLegend" style="font-size:12px;">
        <span style="color:#1F4E5C;">&#9679;</span>&nbsp;2026&nbsp;&nbsp;
        <span id="compareYearLabel" style="color:#B4B2A9;">&#9679;</span>&nbsp;<span id="compareYearText">2025</span>
    </div>
    <canvas id="yoyChart" height="80"></canvas>
</div>

<h6 class="mb-3">Istorija cene (poslednjih 5 promena)</h6>
<table class="table">
    <thead>
        <tr class="text-secondary small">
            <th>Datum promene</th>
            <th>Prethodna cena</th>
            <th>Nova cena</th>
            <th>Rabat</th>
        </tr>
    </thead>
    <tbody>
        <tr><td>22.07.2026.</td><td>149,90 RSD</td><td>159,21 RSD</td><td>10%</td></tr>
        <tr><td>05.06.2026.</td><td>139,90 RSD</td><td>149,90 RSD</td><td>0%</td></tr>
        <tr><td>18.04.2026.</td><td>144,90 RSD</td><td>139,90 RSD</td><td>15%</td></tr>
        <tr><td>02.03.2026.</td><td>134,90 RSD</td><td>144,90 RSD</td><td>0%</td></tr>
        <tr><td>11.01.2026.</td><td>139,90 RSD</td><td>134,90 RSD</td><td>5%</td></tr>
    </tbody>
</table>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    <script src="~/js/artikal.js"></script>
}
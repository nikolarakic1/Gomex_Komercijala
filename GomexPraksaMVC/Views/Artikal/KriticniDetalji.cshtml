@using System.Globalization
@model GomexPraksaMVC.Models.CriticalArticleDetailsViewItem

@{
    ViewData["Title"] = "Analiza kritičnog artikla";

    var culture =
        CultureInfo.GetCultureInfo(
            "sr-Latn-RS"
        );

    var godinaOd =
        Convert.ToInt32(
            ViewData["GodinaOd"] ?? 2025
        );

    var godinaDo =
        Convert.ToInt32(
            ViewData["GodinaDo"] ?? 2026
        );

    var actualOd =
        Model.Performanse
            .Where(x =>
                x.Godina == godinaOd &&
                x.Tip.Equals(
                    "ACTUAL",
                    StringComparison.OrdinalIgnoreCase
                )
            )
            .ToList();

    var actualDo =
        Model.Performanse
            .Where(x =>
                x.Godina == godinaDo &&
                x.Tip.Equals(
                    "ACTUAL",
                    StringComparison.OrdinalIgnoreCase
                )
            )
            .ToList();

    var planDo =
        Model.Performanse
            .Where(x =>
                x.Godina == godinaDo &&
                x.Tip.Equals(
                    "PLAN",
                    StringComparison.OrdinalIgnoreCase
                )
            )
            .ToList();

    var redovna =
        actualDo
            .Where(x =>
                x.VrstaProdaje.Equals(
                    "REDOVNA",
                    StringComparison.OrdinalIgnoreCase
                )
            )
            .ToList();

    var akcijska =
        actualDo
            .Where(x =>
                x.VrstaProdaje.Equals(
                    "AKCIJSKA",
                    StringComparison.OrdinalIgnoreCase
                )
            )
            .OrderByDescending(x =>
                x.CmUtice
            )
            .ThenBy(x =>
                x.Ruc12Procenat
            )
            .ToList();

    decimal actualPrometOd =
        actualOd.Sum(x => x.Promet);

    decimal actualRucOd =
        actualOd.Sum(x => x.Ruc12);

    decimal actualPctOd =
        actualPrometOd == 0
            ? 0
            : actualRucOd /
              actualPrometOd;

    decimal actualPrometDo =
        actualDo.Sum(x => x.Promet);

    decimal actualRucDo =
        actualDo.Sum(x => x.Ruc12);

    decimal actualPctDo =
        actualPrometDo == 0
            ? 0
            : actualRucDo /
              actualPrometDo;

    decimal planPromet =
        planDo.Sum(x => x.Promet);

    decimal planRuc =
        planDo.Sum(x => x.Ruc12);

    decimal planPct =
        planPromet == 0
            ? 0
            : planRuc /
              planPromet;

    decimal redovnaPromet =
        redovna.Sum(x => x.Promet);

    decimal redovnaRuc =
        redovna.Sum(x => x.Ruc12);

    decimal redovnaPct =
        redovnaPromet == 0
            ? 0
            : redovnaRuc /
              redovnaPromet;

    decimal akcijskaPromet =
        akcijska.Sum(x => x.Promet);

    decimal akcijskaRuc =
        akcijska.Sum(x => x.Ruc12);

    decimal akcijskaPct =
        akcijskaPromet == 0
            ? 0
            : akcijskaRuc /
              akcijskaPromet;

    decimal prometPromena =
        actualPrometOd == 0
            ? 0
            : (
                actualPrometDo -
                actualPrometOd
              ) /
              Math.Abs(actualPrometOd);

    decimal rucPromena =
        actualRucOd == 0
            ? 0
            : (
                actualRucDo -
                actualRucOd
              ) /
              Math.Abs(actualRucOd);

    decimal rucPp =
        (
            actualPctDo -
            actualPctOd
        ) * 100m;

    decimal planPp =
        (
            actualPctDo -
            planPct
        ) * 100m;

    var sveAkcije =
        Model.Performanse
            .Where(x =>
                x.Tip.Equals(
                    "ACTUAL",
                    StringComparison.OrdinalIgnoreCase
                )
                &&
                x.VrstaProdaje.Equals(
                    "AKCIJSKA",
                    StringComparison.OrdinalIgnoreCase
                )
            )
            .GroupBy(x =>
                x.TipAkcije
            )
            .Select(g => new
            {
                Naziv =
                    g.Key,

                Godine =
                    g.Select(x => x.Godina)
                        .Distinct()
                        .OrderBy(x => x)
                        .ToList(),

                Kolicina =
                    g.Sum(x => x.Kolicina),

                Promet =
                    g.Sum(x => x.Promet),

                Ruc =
                    g.Sum(x => x.Ruc12),

                CmUtice =
                    g.Any(x => x.CmUtice)
            })
            .OrderByDescending(x =>
                x.CmUtice
            )
            .ThenByDescending(x =>
                x.Promet
            )
            .ToList();

    string Money(decimal value)
    {
        return value.ToString(
            "N0",
            culture
        );
    }

    string Number(decimal value)
    {
        return value.ToString(
            "N2",
            culture
        );
    }

    string Percent(decimal value)
    {
        return (
            value * 100m
        ).ToString(
            "N2",
            culture
        ) + "%";
    }

    string ValueClass(decimal value)
    {
        if (value < 0)
        {
            return "negative";
        }

        if (value < 0.05m)
        {
            return "warning";
        }

        return "positive";
    }

    string DeltaClass(decimal value)
    {
        if (value < 0)
        {
            return "negative";
        }

        if (value > 0)
        {
            return "positive";
        }

        return "neutral";
    }
}


<div class="critical-detail-page">

    <div class="detail-topbar">

        <a asp-controller="Artikal"
           asp-action="Kriticni"
           class="detail-back">
            <i class="bi bi-arrow-left"></i>
            Nazad na kritične artikle
        </a>

        <form method="get"
              asp-controller="Artikal"
              asp-action="KriticniDetalji"
              class="year-form">

            <input type="hidden"
                   name="sifra"
                   value="@Model.Sifra" />

            <span>Uporedi</span>

            <select name="godinaOd">

                @for (
                    int y =
                        DateTime.Today.Year - 5;
                    y <= DateTime.Today.Year;
                    y++
                )
                {
                    if (y == godinaOd)
                    {
                        <option value="@y"
                                selected>
                            @y
                        </option>
                    }
                    else
                    {
                        <option value="@y">
                            @y
                        </option>
                    }
                }

            </select>

            <span>sa</span>

            <select name="godinaDo">

                @for (
                    int y =
                        DateTime.Today.Year - 5;
                    y <= DateTime.Today.Year;
                    y++
                )
                {
                    if (y == godinaDo)
                    {
                        <option value="@y"
                                selected>
                            @y
                        </option>
                    }
                    else
                    {
                        <option value="@y">
                            @y
                        </option>
                    }
                }

            </select>

            <button type="submit">
                Primeni
            </button>

        </form>

    </div>

    <div class="detail-hero">

        <div class="hero-info">

            <span class="article-code">
                @Model.Sifra
            </span>

            <h1>
                @Model.Naziv
            </h1>

            <div class="hero-meta">

                <span>
                    Dobavljač:
                    <strong>
                        @(Model.Dobavljac ?? "-")
                    </strong>
                </span>

                <span>
                    Artikal ID:
                    <strong>
                        @Model.ArtikalId
                    </strong>
                </span>

            </div>

        </div>

        <div class="hero-status">

            <span class="hero-status-label">
                Trenutni status
            </span>

            @if (
                Model.TrenutniStatus.Equals(
                    "AKCIJSKA",
                    StringComparison.OrdinalIgnoreCase
                )
            )
            {
                <span class="
                    status-pill
                    status-action">
                    AKCIJSKA
                </span>

                @if (
                    !string.IsNullOrWhiteSpace(
                        Model.TrenutniTipAkcije
                    )
                )
                {
                    <div class="current-action">
                        @Model.TrenutniTipAkcije
                    </div>
                }
            }
            else
            {
                <span class="
                    status-pill
                    status-regular">
                    REDOVNA
                </span>
            }

            @if (Model.RedovnaCena.HasValue)
            {
                <div class="price-info">

                    <span>
                        Redovna cena
                    </span>

                    <strong>
                        @Number(
                            Model.RedovnaCena.Value
                        ) RSD
                    </strong>

                </div>
            }

            @if (Model.AkcijskaCena.HasValue)
            {
                <div class="price-info">

                    <span>
                        Akcijska cena
                    </span>

                    <strong>
                        @Number(
                            Model.AkcijskaCena.Value
                        ) RSD
                    </strong>

                </div>
            }

        </div>

    </div>

    <div class="detail-card">

        <div class="detail-card-header">

            <div>

                <div class="detail-eyebrow">
                    Glavne performanse
                </div>

                <h2>
                    @godinaOd vs @godinaDo
                </h2>

            </div>

            @if (actualPctDo < 0)
            {
                <span class="
                    health-pill
                    health-danger">
                    Negativan RUC
                </span>
            }
            else if (
                planPromet > 0 &&
                actualPctDo < planPct
            )
            {
                <span class="
                    health-pill
                    health-warning">
                    Ispod plana
                </span>
            }
            else
            {
                <span class="
                    health-pill
                    health-good">
                    Stabilno
                </span>
            }

        </div>

        <div class="kpi-grid">

            <div class="kpi">

                <span class="kpi-label">
                    Promet @godinaDo
                </span>

                <strong>
                    @Money(actualPrometDo)
                </strong>

                <small class="
                    @DeltaClass(prometPromena)">
                    @(
                        prometPromena >= 0
                            ? "+"
                            : ""
                    )
                    @Percent(prometPromena)
                    vs @godinaOd
                </small>

            </div>

            <div class="kpi">

                <span class="kpi-label">
                    RUC12 @godinaDo
                </span>

                <strong class="
                    @ValueClass(actualPctDo)">
                    @Money(actualRucDo)
                </strong>

                <small class="
                    @DeltaClass(rucPromena)">
                    @(
                        rucPromena >= 0
                            ? "+"
                            : ""
                    )
                    @Percent(rucPromena)
                    vs @godinaOd
                </small>

            </div>

            <div class="
                kpi
                kpi-primary">

                <span class="kpi-label">
                    RUC12 %
                </span>

                <strong class="
                    @ValueClass(actualPctDo)">
                    @Percent(actualPctDo)
                </strong>

                <small class="
                    @DeltaClass(rucPp)">
                    @rucPp.ToString(
                        "+0.00;-0.00;0.00"
                    ) p.p.
                </small>

            </div>

            <div class="kpi">

                <span class="kpi-label">
                    Plan RUC %
                </span>

                <strong>
                    @Percent(planPct)
                </strong>

                <small class="
                    @DeltaClass(planPp)">
                    @planPp.ToString(
                        "+0.00;-0.00;0.00"
                    ) p.p.
                </small>

            </div>

        </div>

    </div>

    <div class="detail-card">

        <div class="detail-card-header">

            <div>

                <div class="detail-eyebrow">
                    Struktura prodaje
                </div>

                <h2>
                    Redovna i akcijska prodaja
                </h2>

            </div>

        </div>

        <div class="sales-grid">

            <div class="sales-card">

                <div class="sales-title">

                    <span>
                        REDOVNA
                    </span>

                    <span class="sales-share">
                        @Percent(
                            actualPrometDo == 0
                                ? 0
                                : redovnaPromet /
                                  actualPrometDo
                        )
                        prometa
                    </span>

                </div>

                <div class="sales-values">

                    <div>
                        <span>Promet</span>
                        <strong>
                            @Money(redovnaPromet)
                        </strong>
                    </div>

                    <div>
                        <span>RUC12</span>
                        <strong>
                            @Money(redovnaRuc)
                        </strong>
                    </div>

                    <div>
                        <span>RUC12 %</span>
                        <strong class="
                            @ValueClass(redovnaPct)">
                            @Percent(redovnaPct)
                        </strong>
                    </div>

                </div>

            </div>

            <div class="
                sales-card
                action">

                <div class="sales-title">

                    <span>
                        AKCIJSKA
                    </span>

                    <span class="sales-share">
                        @Percent(
                            actualPrometDo == 0
                                ? 0
                                : akcijskaPromet /
                                  actualPrometDo
                        )
                        prometa
                    </span>

                </div>

                <div class="sales-values">

                    <div>
                        <span>Promet</span>
                        <strong>
                            @Money(akcijskaPromet)
                        </strong>
                    </div>

                    <div>
                        <span>RUC12</span>
                        <strong>
                            @Money(akcijskaRuc)
                        </strong>
                    </div>

                    <div>
                        <span>RUC12 %</span>
                        <strong class="
                            @ValueClass(akcijskaPct)">
                            @Percent(akcijskaPct)
                        </strong>
                    </div>

                </div>

            </div>

        </div>

    </div>

    <div class="detail-card">

        <div class="detail-card-header">

            <div>

                <div class="detail-eyebrow">
                    Akcijska istorija
                </div>

                <h2>
                    Sve akcije artikla
                </h2>

            </div>

            <span class="neutral">
                @sveAkcije.Count
                tipova akcija
            </span>

        </div>

        <div class="campaign-grid">

            @foreach (var akcija in sveAkcije)
            {
                decimal pct =
                    akcija.Promet == 0
                        ? 0
                        : akcija.Ruc /
                          akcija.Promet;

                <div class="
                    campaign-card
                    @(akcija.CmUtice
                        ? "cm"
                        : "")">

                    <div class="campaign-head">

                        <div>

                            <span class="badge-action">
                                AKCIJSKA
                            </span>

                            @if (akcija.CmUtice)
                            {
                                <span class="badge-cm">
                                    CM UTIČE
                                </span>
                            }

                            @if (
                                akcija.Naziv.Contains(
                                    "SPECIJAL",
                                    StringComparison.OrdinalIgnoreCase
                                )
                            )
                            {
                                <span class="badge-special">
                                    SPECIJAL
                                </span>
                            }

                            <div class="campaign-name">
                                @akcija.Naziv
                            </div>

                        </div>

                        <div class="
                            campaign-ruc
                            @ValueClass(pct)">

                            @Percent(pct)

                            <span>
                                RUC
                            </span>

                        </div>

                    </div>

                    <div class="campaign-values">

                        <div>
                            <span>Promet</span>
                            <strong>
                                @Money(
                                    akcija.Promet
                                )
                            </strong>
                        </div>

                        <div>
                            <span>RUC12</span>
                            <strong>
                                @Money(
                                    akcija.Ruc
                                )
                            </strong>
                        </div>

                        <div>
                            <span>Količina</span>
                            <strong>
                                @Number(
                                    akcija.Kolicina
                                )
                            </strong>
                        </div>

                    </div>

                    <div class="campaign-years">

                        @foreach (
                            var godina
                            in akcija.Godine
                        )
                        {
                            <span>
                                @godina
                            </span>
                        }

                    </div>

                </div>
            }

        </div>

    </div>

    <div class="detail-card">

        <div class="detail-card-header">

            <div>

                <div class="detail-eyebrow">
                    Detaljna analiza
                </div>

                <h2>
                    Pivot performanse
                </h2>

            </div>

        </div>

        <div class="table-container">

            <table class="detail-table">

                <thead>

                    <tr>

                        <th>
                            Godina
                        </th>

                        <th>
                            Tip
                        </th>

                        <th>
                            Prodaja
                        </th>

                        <th>
                            Akcija
                        </th>

                        <th class="numeric">
                            Količina
                        </th>

                        <th class="numeric">
                            Promet
                        </th>

                        <th class="numeric">
                            RUC12
                        </th>

                        <th class="numeric">
                            RUC12 %
                        </th>

                        <th>
                            CM
                        </th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (
                        var row
                        in Model.Performanse
                            .OrderByDescending(
                                x => x.Godina
                            )
                            .ThenBy(
                                x =>
                                    x.Tip ==
                                    "ACTUAL"
                                        ? 0
                                        : 1
                            )
                            .ThenBy(
                                x =>
                                    x.VrstaProdaje ==
                                    "AKCIJSKA"
                                        ? 0
                                        : 1
                            )
                    )
                    {
                        <tr>

                            <td>
                                <strong>
                                    @row.Godina
                                </strong>
                            </td>

                            <td>

                                <span class="
                                    type-pill
                                    @(row.Tip == "ACTUAL"
                                        ? "actual"
                                        : "plan")">

                                    @row.Tip

                                </span>

                            </td>

                            <td>
                                @row.VrstaProdaje
                            </td>

                            <td>
                                <strong>
                                    @row.TipAkcije
                                </strong>
                            </td>

                            <td class="numeric">
                                @Number(
                                    row.Kolicina
                                )
                            </td>

                            <td class="numeric">
                                @Money(
                                    row.Promet
                                )
                            </td>

                            <td class="
                                numeric
                                @(row.Ruc12 < 0
                                    ? "negative"
                                    : "")">

                                @Money(
                                    row.Ruc12
                                )

                            </td>

                            <td class="
                                numeric
                                @ValueClass(
                                    row.Ruc12Procenat
                                )">

                                @Percent(
                                    row.Ruc12Procenat
                                )

                            </td>

                            <td>

                                @if (row.CmUtice)
                                {
                                    <strong class="positive">
                                        DA
                                    </strong>
                                }
                                else
                                {
                                    <span class="neutral">
                                        NE
                                    </span>
                                }

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

    <div class="detail-card">

        <div class="detail-card-header">

            <div>

                <div class="detail-eyebrow">
                    Uzrok odstupanja
                </div>

                <h2>
                    Efekti
                </h2>

            </div>

        </div>

        <div class="effect-grid">

            <div class="effect-card">

                <span>
                    Margin effect
                </span>

                <strong class="
                    @DeltaClass(
                        Model.MarginEffect
                    )">

                    @Money(
                        Model.MarginEffect
                    )

                </strong>

                <small>
                    Promena marže
                </small>

            </div>

            <div class="effect-card">

                <span>
                    Volume effect
                </span>

                <strong class="
                    @DeltaClass(
                        Model.VolumeEffect
                    )">

                    @Money(
                        Model.VolumeEffect
                    )

                </strong>

                <small>
                    Promena obima prodaje
                </small>

            </div>

            <div class="effect-card">

                <span>
                    Mix effect
                </span>

                <strong class="
                    @DeltaClass(
                        Model.MixEffect
                    )">

                    @Money(
                        Model.MixEffect
                    )

                </strong>

                <small>
                    Struktura prodaje
                </small>

            </div>

            <div class="
                effect-card
                effect-total">

                <span>
                    Total diff
                </span>

                <strong class="
                    @DeltaClass(
                        Model.TotalDiff
                    )">

                    @Money(
                        Model.TotalDiff
                    )

                </strong>

                <small>
                    Actual RUC - Plan RUC
                </small>

            </div>

        </div>

    </div>

</div>
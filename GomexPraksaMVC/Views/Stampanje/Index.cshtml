@{
    ViewData["Title"] = "Štampanje / Izveštaji";
}

<div class="dashboard-header mb-4">
    <div class="d-flex justify-content-between align-items-start">
        <div>
            <h2 class="mb-1">Štampanje — Komercijalni rezultati</h2>
            <p class="text-secondary mb-0">Izaberite datum i otvorite izveštaj za štampu.</p>
        </div>
    </div>
    <div>
        <a href="javascript:history.back()" class="btn btn-link text-decoration-none">&larr; Nazad</a>
    </div>
</div>

<div class="card mb-4" style="max-width:720px">
    <div class="card-body">
        <form method="get" asp-action="PrintKomercijalni" target="_blank" class="row g-2 align-items-end">
            <div class="col-md-6">
                <label class="form-label">Datum</label>
                <input type="date" name="datum" class="form-control" />
            </div>
            <div class="col-md-6 d-flex justify-content-start">
                <button type="submit" class="btn btn-primary mt-2">

                    Otvori za štampu
                </button>
            </div>
        </form>
    </div>
</div>

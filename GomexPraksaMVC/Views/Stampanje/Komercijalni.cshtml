@{
    Layout = "_Layout";

    var datumOd =
        ViewData["DatumOd"]?.ToString();

    var datumDo =
        ViewData["DatumDo"]?.ToString();
}

<div class="container py-4">

    <div class="mb-4">
        <h2>Komercijalni izveštaj</h2>
        <p class="text-muted mb-0">
            Izaberite period za RUC PLAN / ACTUAL izveštaj.
        </p>
    </div>

    @if (TempData["PrintError"] != null)
    {
        <div class="alert alert-danger">
            @TempData["PrintError"]
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body">

            <form asp-controller="Stampanje"
                  asp-action="PrintKomercijalni"
                  method="get">

                <div class="row g-3 align-items-end">

                    <div class="col-md-4">
                        <label for="datumOd"
                               class="form-label">
                            Datum od
                        </label>

                        <input type="date"
                               id="datumOd"
                               name="datumOd"
                               value="@datumOd"
                               class="form-control"
                               required />
                    </div>

                    <div class="col-md-4">
                        <label for="datumDo"
                               class="form-label">
                            Datum do
                        </label>

                        <input type="date"
                               id="datumDo"
                               name="datumDo"
                               value="@datumDo"
                               class="form-control"
                               required />
                    </div>

                    <div class="col-md-4">
                        <button type="submit"
                                class="btn btn-primary w-100">
                            Prikaži izveštaj
                        </button>
                    </div>

                </div>

            </form>

        </div>
    </div>

</div>
@model GomexPraksaMVC.Models.RucChangeViewItem

@{
    Layout = "_Layout";

    var datumOd =
        ViewData["DatumOd"]?.ToString();

    var datumDo =
        ViewData["DatumDo"]?.ToString();
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-start mb-4">

        <div>
            <h2 class="mb-1">
                Komercijalni RUC izveštaj
            </h2>

            <div class="text-muted">
                Period:
                <strong>@datumOd</strong>
                -
                <strong>@datumDo</strong>
            </div>
        </div>

        <button type="button"
                class="btn btn-outline-secondary no-print"
                onclick="window.print()">
            Štampaj
        </button>

    </div>

    @if (Model == null)
    {
        <div class="alert alert-warning">
            Nema dostupnih podataka za izabrani period.
        </div>
    }
    else
    {
        <div class="row g-3 mb-4">

            <div class="col-md-3">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <div class="text-muted small">
                            PLAN RUC
                        </div>

                        <div class="fs-4 fw-bold">
                            @(Model.PocetniRuc.ToString("N0")) RSD
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <div class="text-muted small">
                            ACTUAL RUC
                        </div>

                        <div class="fs-4 fw-bold">
                            @(Model.KonacniRuc.ToString("N0")) RSD
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <div class="text-muted small">
                            Ukupna promena
                        </div>

                        <div class="fs-4 fw-bold">
                            @(Model.UkupnaPromena.ToString("N0")) RSD
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <div class="text-muted small">
                            Promena %
                        </div>

                        <div class="fs-4 fw-bold">
                            @((Model.UkupnaPromenaProcenat * 100m).ToString("0.00"))%
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <div class="card shadow-sm mb-4">

            <div class="card-header">
                RUC waterfall
            </div>

            <div class="card-body p-0">

                <div class="table-responsive">

                    <table class="table table-striped mb-0">

                        <thead>
                            <tr>
                                <th>Stavka</th>
                                <th class="text-end">
                                    Vrednost
                                </th>
                            </tr>
                        </thead>

                        <tbody>

                            <tr>
                                <td>PLAN RUC</td>
                                <td class="text-end">
                                    @(Model.PocetniRuc.ToString("N0")) RSD
                                </td>
                            </tr>

                            <tr>
                                <td>Margin effect</td>
                                <td class="text-end">
                                    @(Model.MarginEffect.ToString("N0")) RSD
                                </td>
                            </tr>

                            <tr>
                                <td>Volume effect</td>
                                <td class="text-end">
                                    @(Model.VolumeEffect.ToString("N0")) RSD
                                </td>
                            </tr>

                            <tr>
                                <td>Mix effect</td>
                                <td class="text-end">
                                    @(Model.MixEffect.ToString("N0")) RSD
                                </td>
                            </tr>

                            <tr class="fw-bold">
                                <td>ACTUAL RUC</td>
                                <td class="text-end">
                                    @(Model.KonacniRuc.ToString("N0")) RSD
                                </td>
                            </tr>

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

        <div class="card shadow-sm">

            <div class="card-body">

                <div class="d-flex justify-content-between">
                    <span>
                        Kontrolna razlika
                    </span>

                                    </div>

            </div>

        </div>
    }

</div>

<style>
    @@media print {

        .no-print,
        header,
        nav,
        footer {
            display: none !important;
        }

        body {
            background: white !important;
        }

        .container {
            max-width: 100% !important;
        }

        .card {
            box-shadow: none !important;
            border: 1px solid #ddd !important;
        }
    }
</style>
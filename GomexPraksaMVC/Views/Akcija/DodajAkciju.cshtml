@model GomexPraksaMVC.Models.DodajAkcijuViewModel

@{
    ViewData["Title"] = "Dodaj akciju";
}

<link rel="stylesheet" href="~/css/akcija-dodaj.css" asp-append-version="true" />

<div class="add-action-page">

    <div class="add-action-header">

        <div>
            <h2 class="add-action-title">
                Dodaj akciju
            </h2>

            <p class="add-action-subtitle">
                Kreiranje nove akcije za izabrani artikal
            </p>
        </div>

        <a asp-controller="Akcija"
           asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-1"></i>

            Nazad na akcije

        </a>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert success-alert mb-4">

            <i class="bi bi-check-circle me-2"></i>

            @TempData["Success"]

        </div>
    }

    <div class="add-action-card">

        <div class="add-action-card-header">

            <div class="add-action-card-header-title">
                Nova akcija
            </div>

            <div class="add-action-card-header-text">
                Unesite artikal, tip akcije, period i akcijsku cenu
            </div>

        </div>

        <form asp-controller="Akcija"
              asp-action="DodajAkciju"
              method="post">

            @Html.AntiForgeryToken()

            <div class="add-action-body">

                <div asp-validation-summary="ModelOnly">
                </div>

                <div class="form-section">

                    <div class="form-section-title">
                        Artikal i tip akcije
                    </div>

                    <div class="row g-3">

                        <div class="col-md-6" style="position:relative;">

                            <label asp-for="SifraArtikla"
                                   class="form-label">

                                Šifra artikla

                            </label>

                            <input asp-for="SifraArtikla"
                                   class="form-control"
                                   placeholder="Na primer 10118"
                                   autocomplete="off" />

                            <div id="article-suggestions" class="list-group position-absolute w-100" style="z-index:1000;display:none;max-height:240px;overflow:auto;"></div>

                            <span asp-validation-for="SifraArtikla"
                                  class="text-danger">
                            </span>

                            <div id="article-preview" class="mt-3" style="display:none;">
                                <div class="card p-2" style="border:1px solid #e6ebe8;border-radius:8px;background:#fbfdfc;">
                                    <div id="article-name" style="font-weight:700;color:#2f3934;"></div>
                                    <div id="article-price" style="color:#4b5650;margin-top:4px;"></div>
                                </div>
                            </div>

                        </div>

                        <div class="col-md-6">

                            <label asp-for="TipAkcijeId"
                                   class="form-label">

                                Tip akcije

                            </label>

                            <select asp-for="TipAkcijeId"
                                    class="form-select">

                                <option value="0">
                                    Izaberite tip akcije
                                </option>

                                @foreach (var tip in Model.TipoviAkcija)
                                {
                                    <option value="@tip.TipAkcijeId">
                                        @tip.Naziv
                                    </option>
                                }

                            </select>

                            <span asp-validation-for="TipAkcijeId"
                                  class="text-danger">
                            </span>

                            @if (!Model.TipoviAkcija.Any())
                            {
                                <div class="empty-types">
                                    Nema dostupnih tipova akcije.
                                </div>
                            }

                        </div>

                    </div>

                </div>

                <div class="form-section">

                    <div class="form-section-title">
                        Period akcije
                    </div>

                    <div class="row g-3">

                        <div class="col-md-6">

                            <label asp-for="DatumOd"
                                   class="form-label">

                                Datum od

                            </label>

                            <input asp-for="DatumOd"
                                   type="date"
                                   class="form-control" />

                            <span asp-validation-for="DatumOd"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="col-md-6">

                            <label asp-for="DatumDo"
                                   class="form-label">

                                Datum do

                            </label>

                            <input asp-for="DatumDo"
                                   type="date"
                                   class="form-control" />

                            <span asp-validation-for="DatumDo"
                                  class="text-danger">
                            </span>

                        </div>

                    </div>

                </div>

                <div class="form-section">

                    <div class="form-section-title">
                        Cena
                    </div>

                    <div class="row g-3">

                        <div class="col-md-6">

                            <label asp-for="AkcijskaCena"
                                   class="form-label">

                                Akcijska cena

                            </label>

                            <div class="input-group">

                                <input asp-for="AkcijskaCena"
                                       type="number"
                                       step="0.01"
                                       min="0.01"
                                       class="form-control"
                                       placeholder="0.00"
                                       id="akcijska-cena" />
                                <span class="input-group-text">
                                    RSD
                                </span>

                                <span class="input-group-text" style="border-left:1px solid #d6dfda;border-right:0;background:#f7fbf9;">
                                    % popusta
                                </span>

                                <input type="number"
                                       id="discount-percent"
                                       name="DiscountPercent"
                                       class="form-control"
                                       step="1"
                                       min="0"
                                       max="99.99"
                                       placeholder="0.00" />

                            </div>

                            <span asp-validation-for="AkcijskaCena"
                                  class="text-danger">
                            </span>

                        </div>

                    </div>

                </div>

                <div class="info-box">

                    <i class="bi bi-info-circle"></i>

                    <div>
                        Akcija će biti pronađena preko šifre artikla.
                        Tip akcije se učitava iz baze, a datum se šalje bez vremena.
                    </div>

                </div>

            </div>

            <div class="action-footer">

                <div class="action-footer-left">
                    Šifra, tip akcije, period i cena su obavezni.
                </div>

                <div class="action-footer-buttons">

                    <a asp-controller="Akcija"
                       asp-action="Index"
                       class="btn btn-outline-secondary btn-add-action">

                        Odustani

                    </a>

                    <button type="submit"
                            class="btn btn-primary btn-add-action"
                            disabled="@(!Model.TipoviAkcija.Any())">

                        <i class="bi bi-plus-circle me-1"></i>

                        Dodaj akciju

                    </button>

                </div>

            </div>

        </form>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/akcija-dodaj.js" asp-append-version="true"></script>
}
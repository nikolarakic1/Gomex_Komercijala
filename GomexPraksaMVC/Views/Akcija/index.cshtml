@model List<GomexPraksaMVC.Models.AkcijaGrupaViewItem>

@{
    ViewData["Title"] = "Akcije";

    var activeTab =
        ViewData["ActiveTab"] as string
        ?? "trenutne";
}

<div class="dashboard-header mb-4">

    <div class="d-flex justify-content-between align-items-center gap-3">

        <div>

            <h2 class="mb-1">
                Akcije
            </h2>

            <p class="text-secondary mb-0">
                Pregled aktivnih akcija i proizvoda unutar njih
            </p>

        </div>

        <a asp-controller="Akcija"
           asp-action="DodajAkciju"
           class="btn btn-primary">

            <i class="bi bi-plus-circle me-1"></i>

            Dodaj akciju

        </a>

    </div>

</div>

<ul class="nav nav-tabs mb-4">

    <li class="nav-item">

        <a class="nav-link @(activeTab == "trenutne" ? "active" : "")"
           asp-controller="Akcija"
           asp-action="Index"
           asp-route-tab="trenutne">

            Trenutne

        </a>

    </li>

    <li class="nav-item">

        <a class="nav-link @(activeTab == "buduce" ? "active" : "")"
           asp-controller="Akcija"
           asp-action="Index"
           asp-route-tab="buduce">

            Buduće

        </a>

    </li>

    <li class="nav-item">

        <a class="nav-link @(activeTab == "prethodne" ? "active" : "")"
           asp-controller="Akcija"
           asp-action="Index"
           asp-route-tab="prethodne">

            Prethodne

        </a>

    </li>

</ul>

@if (!Model.Any())
{
    <div class="metric-card text-center py-5 text-secondary">

        <div class="mb-3">

            <i class="bi bi-calendar-x"
               style="font-size:32px;">
            </i>

        </div>

        <div>
            Nema akcija za ovaj period.
        </div>

    </div>
}
else
{
    <div class="row g-3">

        @foreach (var grupa in Model)
        {
            <div class="col-xl-4 col-md-6">

                <div class="
                    metric-card
                    h-100
                    d-flex
                    flex-column
                    justify-content-between
                    ">

                    <div>

                        <div class="
                            d-flex
                            justify-content-between
                            align-items-start
                            mb-3
                            ">

                            <span class="badge"
                                  style="
                                background:#E7F3EC;
                                color:#2E7D5B;
                                font-size:12px;
                                padding:6px 12px;
                                ">

                                @grupa.TipAkcije

                            </span>

                            <span class="text-secondary small">

                                @grupa.BrojArtikala
                                artikala

                            </span>

                        </div>

                        <div class="text-secondary small mb-3">

                            Period:

                            <strong class="text-dark">

                                @grupa.DatumOd.ToString("dd.MM.yyyy")

                                -

                                @grupa.DatumDo.ToString("dd.MM.yyyy")

                            </strong>

                        </div>

                        <div class="row g-2 mb-3">

                            <div class="col-6">

                                <div class="border rounded p-2">

                                    <div class="text-secondary small">
                                        Actual promet
                                    </div>

                                    <div class="fw-semibold">

                                        @grupa.UkupanActualPromet.ToString("N0")

                                        <span class="text-secondary small">
                                            RSD
                                        </span>

                                    </div>

                                </div>

                            </div>

                            <div class="col-6">

                                <div class="border rounded p-2">

                                    <div class="text-secondary small">
                                        Actual RUC12
                                    </div>

                                    <div class="fw-semibold">

                                        @grupa.UkupanActualRUC12.ToString("N0")

                                        <span class="text-secondary small">
                                            RSD
                                        </span>

                                    </div>

                                </div>

                            </div>

                            <div class="col-12">

                                <div class="border rounded p-2">

                                    <div class="text-secondary small">
                                        Actual RUC12 %
                                    </div>

                                    <div class="fw-semibold">

                                        @(
                                            (grupa.ActualRUC12Procenat * 100m)
                                            .ToString("N2")
                                        )%

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                    <a asp-controller="Akcija"
                       asp-action="Periods"
                       asp-route-tipAkcije="@grupa.TipAkcije"
                       asp-route-tab="@activeTab"
                       class="btn btn-outline-secondary btn-sm w-100">

                        Prikaži periode

                    </a>

                </div>

            </div>
        }

    </div>
}
@model GomexPraksaMVC.Models.AkcijaGrupaViewItem
@{
    ViewData["Title"] = "Proizvodi u akciji";
    var tab = ViewData["Tab"] as string ?? "trenutne";
}

<a asp-action="Index" asp-route-tab="@tab" class="text-decoration-none text-secondary small mb-3 d-inline-block">
    &larr; Nazad na akcije
</a>

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h4 class="mb-1">@Model.TipAkcije</h4>
        <div class="text-secondary small">
            @Model.DatumOd.ToString("dd.MM.yyyy.") &ndash; @Model.DatumDo.ToString("dd.MM.yyyy.")
            &middot; @Model.BrojArtikala artikala
        </div>
    </div>
</div>

    <form method="get" class="mb-3">
        <input type="hidden" name="tipAkcije" value="@Model.TipAkcije" />
        <input type="hidden" name="tab" value="@tab" />
        <div class="input-group input-group-sm" style="max-width:360px">
            <input name="filter" value="@Context.Request.Query["filter"]" type="text" class="form-control" placeholder="Pretraži po nazivu ili šifri..." />
            <button class="btn btn-outline-secondary" type="submit">Traži</button>
        </div>
    </form>

<div class="metric-card">
    <div class="table-responsive">
        <table class="table table-sm table-striped">
            <thead>
                <tr>
                    <th>Artikal</th>
                    <th>Period akcije</th>
                    <th>Šifra</th>
                    <th class="text-end">Redovna cena</th>
                    <th class="text-end">Akcijska cena</th>
                    <th class="text-end">Popust</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in Model.Artikli)
                {
                    <tr>
                        <td>@(a.ArtikalNaziv ?? $"Artikal #{a.ArtikalId}")</td>
                        <td class="text-nowrap">@a.DatumOd.ToString("dd.MM.yyyy.") &ndash; @a.DatumDo.ToString("dd.MM.yyyy.")</td>
                        <td>@a.ArtikalSifra</td>
                        <td class="text-end">@(a.RedovnaCena.HasValue ? a.RedovnaCena.Value.ToString("N2") + " RSD" : "-")</td>
                        <td class="text-end">@a.AkcijskaCena.ToString("N2") RSD</td>
                        <td class="text-end">
                            @if (a.ProcenatPopusta.HasValue)
                            {
                                <span class="text-success">-@a.ProcenatPopusta.Value%</span>
                            }
                            else
                            {
                                <span class="text-secondary">-</span>
                            }
                        </td>
                        <td class="text-end">
                            @if (!string.IsNullOrWhiteSpace(a.ArtikalSifra))
                            {
                                <a asp-controller="Artikal" asp-action="Detalji" asp-route-sifra="@a.ArtikalSifra" class="btn btn-sm btn-outline-secondary">Detalji artikla</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
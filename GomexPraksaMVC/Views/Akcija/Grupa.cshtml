@model GomexPraksaMVC.Models.AkcijaGrupaViewItem

@{
    ViewData["Title"] = "Proizvodi u akciji";
    var tab = ViewData["Tab"] as string ?? "trenutne";

    var prosecniPopust = Model.Artikli
        .Where(x => x.ProcenatPopusta.HasValue)
        .Select(x => x.ProcenatPopusta!.Value)
        .DefaultIfEmpty(0)
        .Average();

    var najveciPopust = Model.Artikli
        .Where(x => x.ProcenatPopusta.HasValue)
        .Select(x => x.ProcenatPopusta!.Value)
        .DefaultIfEmpty(0)
        .Max();

    var saPoznatomCenom = Model.Artikli
        .Count(x => x.RedovnaCena.HasValue);
}

<a asp-action="Index"
   asp-route-tab="@tab"
   class="text-decoration-none text-secondary small mb-3 d-inline-block">
    &larr; Nazad na akcije
</a>

<div class="d-flex justify-content-between align-items-start mb-4">

    <div>
        <h4 class="mb-1">
            @Model.TipAkcije
        </h4>

        <div class="text-secondary small">
            @Model.DatumOd.ToString("dd.MM.yyyy.")
            &ndash;
            @Model.DatumDo.ToString("dd.MM.yyyy.")

            &middot;

            @Model.BrojArtikala artikala
        </div>
    </div>

</div>

<!-- =========================================
     PREGLED AKCIJE
     ========================================= -->

<div class="row g-3 mb-4">

    <div class="col-md-3">
        <div class="metric-card h-100">

            <div class="text-secondary small mb-1">
                Broj artikala
            </div>

            <div class="fs-4 fw-semibold">
                @Model.BrojArtikala
            </div>

        </div>
    </div>

    <div class="col-md-3">
        <div class="metric-card h-100">

            <div class="text-secondary small mb-1">
                Prosečan popust
            </div>

            <div class="fs-4 fw-semibold">
                @prosecniPopust.ToString("N1")%
            </div>

        </div>
    </div>

    <div class="col-md-3">
        <div class="metric-card h-100">

            <div class="text-secondary small mb-1">
                Najveći popust
            </div>

            <div class="fs-4 fw-semibold text-success">
                @najveciPopust.ToString("N1")%
            </div>

        </div>
    </div>

    <div class="col-md-3">
        <div class="metric-card h-100">

            <div class="text-secondary small mb-1">
                Artikli sa cenom
            </div>

            <div class="fs-4 fw-semibold">
                @saPoznatomCenom / @Model.BrojArtikala
            </div>

        </div>
    </div>

</div>

<!-- =========================================
     PRETRAGA
     ========================================= -->

<form method="get" class="mb-3">

    <input type="hidden"
           name="tipAkcije"
           value="@Model.TipAkcije" />

    <input type="hidden"
           name="tab"
           value="@tab" />

    <div class="input-group input-group-sm"
         style="max-width:420px">

        <input name="filter"
               value="@Context.Request.Query["filter"]"
               type="text"
               class="form-control"
               placeholder="Pretraži po nazivu ili šifri..." />

        <button class="btn btn-outline-secondary"
                type="submit">
            Traži
        </button>

    </div>

</form>

<!-- =========================================
     TABELA
     ========================================= -->

<div class="metric-card">

    <div class="table-responsive">

        <table class="table table-sm table-striped align-middle mb-0">

            <thead>

                <tr>
                    <th>Artikal</th>

                    <th>Šifra</th>

                    <th>Period akcije</th>

                    <th class="text-end">
                        Redovna cena
                    </th>

                    <th class="text-end">
                        Akcijska cena
                    </th>

                    <th class="text-end">
                        Ušteda
                    </th>

                    <th class="text-end">
                        Popust
                    </th>

                    <th></th>
                </tr>

            </thead>

            <tbody>

                @foreach (var a in Model.Artikli)
                {
                    var usteda =
                        a.RedovnaCena.HasValue
                            ? a.RedovnaCena.Value - a.AkcijskaCena
                            : (decimal?)null;

                    <tr>

                        <td>

                            <div class="fw-semibold">
                                @(a.ArtikalNaziv
                                    ?? $"Artikal #{a.ArtikalId}")
                            </div>

                        </td>

                        <td class="text-secondary">
                            @a.ArtikalSifra
                        </td>

                        <td class="text-nowrap">

                            @a.DatumOd.ToString("dd.MM.yyyy.")
                            &ndash;
                            @a.DatumDo.ToString("dd.MM.yyyy.")

                        </td>

                        <td class="text-end">

                            @if (a.RedovnaCena.HasValue)
                            {
                                @($"{a.RedovnaCena.Value:N2} RSD")
                            }
                            else
                            {
                                <span class="text-secondary">
                                    -
                                </span>
                            }

                        </td>

                        <td class="text-end fw-semibold">

                            @a.AkcijskaCena.ToString("N2") RSD

                        </td>

                        <td class="text-end">

                            @if (usteda.HasValue && usteda.Value > 0)
                            {
                                <span>
                                    @usteda.Value.ToString("N2") RSD
                                </span>
                            }
                            else
                            {
                                <span class="text-secondary">
                                    -
                                </span>
                            }

                        </td>

                        <td class="text-end">

                            @if (a.ProcenatPopusta.HasValue)
                            {
                                var procenat =
                                    a.ProcenatPopusta.Value;

                                if (procenat >= 30)
                                {
                                    <span class="badge bg-danger">
                                        -@procenat%
                                    </span>
                                }
                                else if (procenat >= 15)
                                {
                                    <span class="badge bg-warning text-dark">
                                        -@procenat%
                                    </span>
                                }
                                else
                                {
                                    <span class="badge"
                                          style="
                                        background:#E7F3EC;
                                        color:#2E7D5B;
                                        ">
                                        -@procenat%
                                    </span>
                                }
                            }
                            else
                            {
                                <span class="text-secondary">
                                    -
                                </span>
                            }

                        </td>

                        <td class="text-end">

                            @if (!string.IsNullOrWhiteSpace(
                                a.ArtikalSifra))
                            {
                                <a asp-controller="Artikal"
                                   asp-action="Detalji"
                                   asp-route-sifra="@a.ArtikalSifra"
                                   class="btn btn-sm btn-outline-secondary">

                                    Detalji
                                </a>
                            }

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>